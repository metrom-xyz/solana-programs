{
    "type": "module",
    "name": "@metrom-xyz/programs-solana",
    "version": "0.4.0",
    "description": "Smart programs for Metrom.",
    "author": "Federico Luzzi <federico.luzzi@metrom.xyz>",
    "license": "GPL-3.0-or-later",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": "./dist/index.js",
        "./idls/Metrom.json": "./dist/idls/Metrom.json",
        "./idl": "./dist/gen/idl.js",
        "./client": "./dist/gen/client/src/generated/index.js"
    },
    "files": [
        "./dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "lint": "cargo fmt --check && prettier */*.js \"*/**/*{.js,.ts}\" --check",
        "format": "cargo fmt && prettier . -w",
        "lint:commit-message": "commitlint -e",
        "prepare": "husky",
        "build": "node ./build.js",
        "prepublishOnly": "pnpm build"
    },
    "peerDependencies": {
        "@solana/kit": "^6.4.0"
    },
    "dependencies": {
        "@solana/program-client-core": "^6.4.0"
    },
    "devDependencies": {
        "@codama/cli": "^1.5.1",
        "@codama/nodes-from-anchor": "^1.4.1",
        "@codama/renderers-js": "^2.2.0",
        "@commitlint/cli": "^19.5.0",
        "@commitlint/config-conventional": "^19.5.0",
        "@coral-xyz/anchor": "^0.32.1",
        "@solana/spl-token": "^0.4.14",
        "@types/bn.js": "^5.1.0",
        "@types/chai": "^4.3.0",
        "@types/chai-as-promised": "^8.0.2",
        "@types/mocha": "^9.0.0",
        "anchor-bankrun": "^0.5.0",
        "chai": "^4.3.4",
        "chai-as-promised": "^8.0.2",
        "husky": "^9.1.6",
        "mocha": "^9.0.3",
        "prettier": "^2.6.2",
        "ts-mocha": "^10.0.0",
        "tsx": "^4.21.0",
        "typescript": "^5.7.3"
    }
}
